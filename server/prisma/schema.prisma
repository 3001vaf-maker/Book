generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  USER
}

enum BookingRequestStatus {
  PENDING
  IMPORTED
  REJECTED
  CANCELLED
}

enum CapabilityValueType {
  BOOLEAN
  LIMIT
}

enum TenantAccessStatus {
  ACTIVE
  SUSPENDED
}

enum CapabilityAccessChangeType {
  ENABLED
  DISABLED
}

model Tenant {
  id                       String                     @id @default(cuid())
  name                     String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  memberships              Membership[]
  workspaceStates          WorkspaceState[]
  profiles                 Profile[]
  bookingPublication       BookingPublication?
  bookingAccounts          BookingAccount[]
  bookingRequests          BookingRequest[]
  businessStateMeta        BusinessStateMeta?
  businessPeople           BusinessPerson[]
  businessIdentity         BusinessIdentityState?
  businessRecords          BusinessRecord[]
  businessRecordEvents     BusinessRecordEvent[]
  businessOperationalState BusinessOperationalState?
  businessDocuments        BusinessDocumentState?
  businessAuxiliaryState   BusinessAuxiliaryState?
  saasAccess               TenantAccess?
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  onboardingStep    Int              @default(0)
  workspaceUnlocked Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  memberships       Membership[]
  workspaceStates   WorkspaceState[]
  profiles          Profile[]
  platformAdmin     PlatformAdmin?
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model WorkspaceState {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Profile {
  id                  String      @id @default(cuid())
  tenantId            String
  userId              String
  key                 String      @default("profile")
  name                String      @default("")
  surname             String      @default("")
  phone               String      @default("")
  phones              Json
  telegrams           Json
  emails              Json
  about               String      @default("")
  photo               String      @default("")
  profession          String      @default("")
  experience          String      @default("")
  professionAbout     String      @default("")
  customProfessions   Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces Workplace[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Workplace {
  id              String   @id @default(cuid())
  tenantId        String
  profileId       String
  key             String
  position        Int      @default(0)
  photo           String   @default("")
  name            String   @default("")
  color           String   @default("")
  city            String   @default("")
  address         String   @default("")
  phone           String   @default("")
  currency        String   @default("RUB")
  from            String   @default("09:00")
  to              String   @default("18:00")
  links           Json
  about           String   @default("")
  sourceCreatedAt String   @default("")
  sourceUpdatedAt String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([profileId])
}

model BookingPublication {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BookingAccount {
  id              String   @id @default(cuid())
  tenantId        String
  email           String
  passwordHash    String
  name            String   @default("")
  surname         String   @default("")
  phone           String   @default("")
  telegramId      String   @default("")
  consents        Json
  profileData     Json     @default("{}")
  uei             String   @default("")
  discountPercent Float    @default(0)
  visits          Int      @default(0)
  totalSpent      Float    @default(0)
  lastVisit       String   @default("")
  programs        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests BookingRequest[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, phone])
}

model BookingRequest {
  id               String               @id @default(cuid())
  tenantId         String
  accountId        String
  workplaceKey     String
  date             String
  from             String
  to               String
  procedures       Json
  status           BookingRequestStatus @default(PENDING)
  importedRecordId String               @default("")
  recordSnapshot   Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account BookingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, workplaceKey, date])
  @@index([accountId])
}

model BusinessStateMeta {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessPerson {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, position])
}

model BusinessIdentityState {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessRecord {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, recordId])
  @@index([tenantId, position])
}

model BusinessRecordEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId, recordId])
  @@index([tenantId, position])
}

model BusinessOperationalState {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessDocumentState {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessAuxiliaryState {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Capability {
  id             String              @id @default(cuid())
  key            String              @unique
  groupKey       String
  name           String
  description    String              @default("")
  valueType      CapabilityValueType
  defaultEnabled Boolean             @default(false)
  defaultLimit   Int?
  position       Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  planValues      PlanCapability[]
  tenantOverrides TenantCapabilityOverride[]
  accessEvents    CapabilityAccessEvent[]

  @@index([groupKey, position])
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilityValues PlanCapability[]
  tenantAccesses   TenantAccess[]
}

model PlanCapability {
  id           String   @id @default(cuid())
  planId       String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([planId, capabilityId])
  @@index([capabilityId])
}

model TenantAccess {
  tenantId    String             @id
  planId      String?
  status      TenantAccessStatus @default(ACTIVE)
  isPlatformOwnerWorkspace Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan?                      @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrides    TenantCapabilityOverride[]
  accessEvents CapabilityAccessEvent[]

  @@index([planId])
  @@index([status])
}

model TenantCapabilityOverride {
  id           String   @id @default(cuid())
  tenantId     String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([capabilityId])
}

model CapabilityAccessEvent {
  id                    String                     @id @default(cuid())
  tenantId              String
  capabilityId          String
  batchId               String
  changeType            CapabilityAccessChangeType
  summaryAcknowledgedAt DateTime?
  detailAcknowledgedAt  DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, summaryAcknowledgedAt])
  @@index([tenantId, capabilityId, detailAcknowledgedAt])
  @@index([batchId])
}

