generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
}

enum BookingRequestStatus {
  PENDING
  IMPORTED
  REJECTED
  CANCELLED
}

enum AccountContactType {
  EMAIL
  PHONE
  TELEGRAM
}

enum CapabilityValueType {
  BOOLEAN
  LIMIT
}

enum TenantAccessStatus {
  ACTIVE
  SUSPENDED
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Tenant {
  id                       String                     @id @default(cuid())
  name                     String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  memberships              Membership[]
  workspaceStates          WorkspaceState[]
  profiles                 Profile[]
  bookingPublication       BookingPublication?
  createdAccounts          Account[]                   @relation("AccountCreatedViaTenant")
  bookingRequests          BookingRequest[]
  businessStateMeta        BusinessStateMeta?
  people                   Person[]
  ueiState                 UeiState?
  records                  Record[]
  recordEvents             RecordEvent[]
  businessOperationalState BusinessOperationalState?
  documentArchive          TenantDocumentArchive?
  businessAuxiliaryState   BusinessAuxiliaryState?
  financeSettlements       FinanceSettlement[]
  financeArticles          FinanceArticle[]
  financeOperations        FinanceOperation[]
  financeLedgerEntries     FinanceLedgerEntry[]
  saasAccess               TenantAccess?
  tenantInvitations        TenantInvitation[]
  firstRunProgress         FirstRunProgress[]
  activityEvents           PlatformActivityEvent[]
  accountSessions          PlatformSession[]
  notificationPreferences  PlatformNotificationPreference[]
  platformNotices           PlatformNotice[]
}

model PlatformAccount {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  onboardingStep    Int              @default(0)
  workspaceUnlocked Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  memberships       Membership[]
  workspaceStates   WorkspaceState[]
  profiles          Profile[]
  platformAdmin     PlatformAdmin?
  firstRunProgress  FirstRunProgress[]
  activityEvents    PlatformActivityEvent[]
  accountSessions   PlatformSession[]
  notificationPreferences PlatformNotificationPreference[]
  platformNotices   PlatformNotice[]
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  platformAccountId    String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   PlatformAccount   @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([platformAccountId])
}

model WorkspaceState {
  id        String   @id @default(cuid())
  tenantId  String
  platformAccountId    String
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   PlatformAccount   @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([tenantId])
  @@index([platformAccountId])
}

model Profile {
  id                  String      @id @default(cuid())
  tenantId            String
  platformAccountId              String
  key                 String      @default("profile")
  name                String      @default("")
  surname             String      @default("")
  phone               String      @default("")
  phones              Json
  telegrams           Json
  emails              Json
  about               String      @default("")
  photo               String      @default("")
  profession          String      @default("")
  experience          String      @default("")
  professionAbout     String      @default("")
  customProfessions   Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account       PlatformAccount        @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  workplaces Workplace[]

  @@unique([tenantId, platformAccountId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([platformAccountId])
}

model Workplace {
  id              String   @id @default(cuid())
  tenantId        String
  profileId       String
  key             String
  position        Int      @default(0)
  photo           String   @default("")
  name            String   @default("")
  color           String   @default("")
  city            String   @default("")
  address         String   @default("")
  phone           String   @default("")
  currency        String   @default("RUB")
  timeZone        String   @default("Europe/Moscow")
  from            String   @default("09:00")
  to              String   @default("18:00")
  links           Json
  about           String   @default("")
  sourceCreatedAt String   @default("")
  sourceUpdatedAt String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([profileId])
}

model BookingPublication {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String   @id @default(cuid())
  createdViaTenantId String?
  email              String
  passwordHash       String
  name               String   @default("")
  surname            String   @default("")
  phone              String   @default("")
  telegramId         String   @default("")
  profileData        Json     @default("{}")
  discountPercent    Float    @default(0)
  visits             Int      @default(0)
  totalSpent         Float    @default(0)
  lastVisit          String   @default("")
  programs           Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdViaTenant Tenant?          @relation("AccountCreatedViaTenant", fields: [createdViaTenantId], references: [id], onDelete: SetNull)
  contacts         AccountContact[]
  requests         BookingRequest[]

  @@index([createdViaTenantId])
}

model AccountContact {
  id        String             @id @default(cuid())
  accountId String
  type      AccountContactType
  value     String
  isPrimary Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([accountId, type])
}

model BookingRequest {
  id               String               @id @default(cuid())
  tenantId         String
  accountId        String
  workplaceKey     String
  date             String
  from             String
  to               String
  procedures       Json
  status           BookingRequestStatus @default(PENDING)
  importedRecordId String               @default("")
  recordSnapshot   Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, workplaceKey, date])
  @@index([accountId])
}

model BusinessStateMeta {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Person {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, position])
}

model UeiState {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Record {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, recordId])
  @@index([tenantId, position])
  @@map("BusinessRecord")
}

model RecordEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId, recordId])
  @@index([tenantId, position])
  @@map("BusinessRecordEvent")
}

model BusinessOperationalState {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantDocumentArchive {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessAuxiliaryState {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  data                Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FinanceArticle {
  id              String    @id @default(cuid())
  tenantId        String
  articleId       String
  parentArticleId String    @default("")
  name            String
  direction       String
  economicType    String
  systemKey       String    @default("")
  position        Int       @default(0)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId])
  @@index([tenantId, parentArticleId, position])
  @@index([tenantId, direction, archivedAt])
}

model FinanceSettlement {
  id         String   @id @default(cuid())
  tenantId   String
  sourceType String
  sourceId   String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, sourceType])
}

model FinanceOperation {
  id                  String   @id @default(cuid())
  tenantId            String
  operationId         String
  kind                String
  status              String   @default("completed")
  sourceType          String
  sourceId            String
  originalOperationId String   @default("")
  occurredAt          DateTime
  data                Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries FinanceLedgerEntry[]

  @@unique([tenantId, operationId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, occurredAt])
}

model FinanceLedgerEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  financeOperationId String
  entryId            String
  walletId           String
  direction          String
  economicType       String
  amount             Decimal  @db.Decimal(14, 2)
  occurredAt         DateTime
  sourceType         String
  sourceId           String
  data               Json
  createdAt          DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operation FinanceOperation @relation(fields: [financeOperationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entryId])
  @@index([tenantId, walletId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([financeOperationId])
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  platformAccountId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account               PlatformAccount               @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  createdInvitations TenantInvitation[]
}

model Capability {
  id             String              @id @default(cuid())
  key            String              @unique
  groupKey       String
  name           String
  description    String              @default("")
  valueType      CapabilityValueType
  defaultEnabled Boolean             @default(false)
  defaultLimit   Int?
  position       Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  planValues      PlanCapability[]
  tenantOverrides TenantCapabilityOverride[]
  tenantOrders    TenantCapabilityOrder[]

  @@index([groupKey, position])
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilityValues PlanCapability[]
  tenantAccesses   TenantAccess[]
}

model PlanCapability {
  id           String   @id @default(cuid())
  planId       String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([planId, capabilityId])
  @@index([capabilityId])
}

model TenantAccess {
  tenantId   String             @id
  planId     String?
  status     TenantAccessStatus @default(ACTIVE)
  isOwnerBook Boolean           @default(false)
  commercialMode String         @default("LIVE")
  demoActivatedAt DateTime?
  demoExpiresAt DateTime?
  demoExtendedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan?                      @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrides TenantCapabilityOverride[]
  capabilityOrder TenantCapabilityOrder[]

  @@index([planId])
  @@index([status])
}

model TenantCapabilityOverride {
  id           String   @id @default(cuid())
  tenantId     String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([capabilityId])
}

model TenantInvitation {
  id               String                 @id @default(cuid())
  tenantId         String
  createdByAdminId String
  email            String
  name             String                 @default("")
  tokenHash        String                 @unique
  status           TenantInvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  activatedAt      DateTime?
  demoExpiresAt    DateTime?
  firstRunScenarioVersionId String?

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy PlatformAdmin @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  firstRunScenarioVersion FirstRunScenarioVersion? @relation(fields: [firstRunScenarioVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email, status])
  @@index([createdByAdminId])
}


model FirstRunScenario {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FirstRunScenarioVersion[]
}

model FirstRunScenarioVersion {
  id          String   @id @default(cuid())
  scenarioId  String
  version     Int
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenario    FirstRunScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  steps       FirstRunStep[]
  invitations TenantInvitation[]
  progress    FirstRunProgress[]

  @@unique([scenarioId, version])
  @@index([scenarioId, status, publishedAt])
}

model FirstRunStep {
  id                String   @id @default(cuid())
  scenarioVersionId String
  key               String
  position          Int
  kind              String
  title             String
  modalTitle        String
  modalBody         String
  primaryLabel      String   @default("Далее")
  skipLabel         String   @default("Пропустить")
  route             String   @default("")
  target            String   @default("")
  completionKey     String   @default("")
  metadata          Json     @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scenarioVersion FirstRunScenarioVersion @relation(fields: [scenarioVersionId], references: [id], onDelete: Cascade)
  progress        FirstRunStepProgress[]

  @@unique([scenarioVersionId, key])
  @@index([scenarioVersionId, position])
}

model FirstRunProgress {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  scenarioVersionId String
  status            String   @default("IN_PROGRESS")
  currentStepKey    String   @default("")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account         PlatformAccount         @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  scenarioVersion FirstRunScenarioVersion @relation(fields: [scenarioVersionId], references: [id], onDelete: Restrict)
  steps           FirstRunStepProgress[]

  @@unique([tenantId, platformAccountId])
  @@index([scenarioVersionId, status])
  @@index([platformAccountId, updatedAt])
}

model FirstRunStepProgress {
  id          String   @id @default(cuid())
  progressId  String
  stepId      String
  status      String   @default("NOT_STARTED")
  modalSeenAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  skippedAt   DateTime?
  lastSeenAt  DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress FirstRunProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  step     FirstRunStep     @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@unique([progressId, stepId])
  @@index([progressId, status])
}

model PlatformActivityEvent {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String?
  sessionId         String?
  eventType         String
  stepKey           String   @default("")
  scenarioVersionId String   @default("")
  metadata          Json     @default("{}")
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)
  session PlatformSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([platformAccountId, occurredAt])
  @@index([eventType, occurredAt])
}

model PlatformSession {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  startedAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  endedAt           DateTime?
  endReason         String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  PlatformAccount         @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  activity PlatformActivityEvent[]

  @@index([tenantId, startedAt])
  @@index([platformAccountId, startedAt])
  @@index([endedAt, lastSeenAt])
}

model TenantCapabilityOrder {
  id           String   @id @default(cuid())
  tenantId     String
  capabilityId String
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([tenantId, position])
  @@index([capabilityId])
}


model PlatformNotificationPreference {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  emailEnabled      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([platformAccountId])
}


model PlatformNotice {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  type              String
  title             String
  body              String   @default("")
  metadata          Json     @default("{}")
  readAt            DateTime?
  createdAt         DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([platformAccountId, readAt, createdAt])
}
