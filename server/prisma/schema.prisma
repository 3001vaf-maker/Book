generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MASTER
}

enum BookingRequestStatus {
  PENDING
  IMPORTED
  REJECTED
  CANCELLED
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  workspaceStates    WorkspaceState[]
  profiles           Profile[]
  bookingPublication BookingPublication?
  bookingAccounts    BookingAccount[]
  bookingRequests    BookingRequest[]
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  onboardingStep    Int              @default(0)
  workspaceUnlocked Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  memberships       Membership[]
  workspaceStates   WorkspaceState[]
  profiles          Profile[]
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model WorkspaceState {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Profile {
  id                  String      @id @default(cuid())
  tenantId            String
  userId              String
  key                 String      @default("profile")
  name                String      @default("")
  surname             String      @default("")
  phone               String      @default("")
  phones              Json
  telegrams           Json
  emails              Json
  about               String      @default("")
  photo               String      @default("")
  profession          String      @default("")
  experience          String      @default("")
  professionAbout     String      @default("")
  customProfessions   Json
  migrationVerifiedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplaces Workplace[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Workplace {
  id              String   @id @default(cuid())
  tenantId        String
  profileId       String
  key             String
  position        Int      @default(0)
  photo           String   @default("")
  name            String   @default("")
  color           String   @default("")
  city            String   @default("")
  address         String   @default("")
  phone           String   @default("")
  currency        String   @default("RUB")
  from            String   @default("09:00")
  to              String   @default("18:00")
  links           Json
  about           String   @default("")
  sourceCreatedAt String   @default("")
  sourceUpdatedAt String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([profileId])
}

model BookingPublication {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BookingAccount {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String   @default("")
  surname      String   @default("")
  phone        String   @default("")
  telegramId   String   @default("")
  consents     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests BookingRequest[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, phone])
}

model BookingRequest {
  id               String               @id @default(cuid())
  tenantId         String
  accountId        String
  workplaceKey     String
  date             String
  from             String
  to               String
  procedures       Json
  status           BookingRequestStatus @default(PENDING)
  importedRecordId String               @default("")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account BookingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, workplaceKey, date])
  @@index([accountId])
}
